{
  "name": "dsh-companion-onboard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Guided setup for a local AI companion: persona/memory files, QQ plugins, environment doctor.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "capabilities.js",
    "capabilities-video.js",
    "capabilities-qq.js",
    "capabilities-memory.js",
    "capabilities-proactive.js",
    "capabilities-douyin.js",
    "companion-config.js",
    "registry-fix.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "templates",
    "astrbot-plugins",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
